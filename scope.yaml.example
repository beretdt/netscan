# Exemplo opcional de escopo para comandos ativos externos.
# Quando fornecido via --scope-file, alvos fora de allowed e alvos em denied serão rejeitados.
engagement: "Cliente XYZ - pentest interno"
contact: "security@example.test"
window:
  start: "2026-01-01T08:00:00"
  end: "2026-01-31T18:00:00"

allowed:
  - 192.168.1.0/24
  - 203.0.113.10
  - example.com

denied:
  - 192.168.1.1
  - admin.example.com
